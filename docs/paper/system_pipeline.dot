digraph DynamicCagePipeline {
  graph [rankdir=TB, bgcolor="white", pad=0.12, nodesep=0.32, ranksep=0.38,
         fontname="Times New Roman", fontsize=12];
  node [shape=box, style="rounded,filled", color="#526778", penwidth=0.9,
        fontname="Times New Roman", fontsize=10, margin="0.13,0.07"];
  edge [color="#526778", penwidth=0.9, arrowsize=0.65,
        fontname="Times New Roman", fontsize=9];

  rgbd [label="Eye-in-hand RGB-D\n10-Hz target-center\nmeasurements", fillcolor="#dbeafe"];
  warmup [label="Five-frame\nvisual bootstrap\n9-D state and covariance", fillcolor="#e0f2fe"];
  kf [label="Kalman filter\npredict · gate · correct", fillcolor="#e0f2fe"];
  fit [label="Causal spline + PCA\nvelocity · curvature\nmotion plane", fillcolor="#dcfce7"];
  cage [label="Arc prior α = 0.4375\nonline 6-D Cage pose", fillcolor="#dcfce7"];
  err [label="Cage-to-TCP pose error\njoint position/velocity", fillcolor="#fef3c7"];
  switch [shape=diamond, label="Position < 15 mm\nand rotation < 45°?", fillcolor="#ffedd5"];
  jac [label="Bounded Jacobian\ncoarse approach", fillcolor="#fee2e2"];
  ppo [label="PPO at 100 Hz\nLocal continuous tracking", fillcolor="#ede9fe"];
  robot [label="UR5e + gripper + target\nMuJoCo forward dynamics", fillcolor="#f3f4f6"];

  {rank=same; rgbd; warmup}
  {rank=same; kf; fit}
  {rank=same; cage; err}
  {rank=same; jac; ppo}
  rgbd -> warmup -> kf -> fit -> cage;
  cage -> err -> switch;
  switch -> jac [label="No"];
  switch -> ppo [label="Yes; latch"];
  jac -> robot;
  ppo -> robot;
  robot -> rgbd [label="Next RGB-D frame", constraint=false, color="#7c3aed"];
}
