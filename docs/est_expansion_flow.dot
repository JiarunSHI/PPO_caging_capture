digraph ESTExpansion {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.34",
    ranksep="0.42",
    fontname="Noto Sans CJK SC",
    label="当前 EST 动力学扩展与候选选择流程",
    labelloc="t",
    fontsize=22
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#31546D",
    fillcolor="#EAF4FA",
    fontname="Noto Sans CJK SC",
    fontsize=12,
    margin="0.16,0.10"
  ];
  edge [color="#4A6475", penwidth=1.4, arrowsize=0.75, fontname="Noto Sans CJK SC", fontsize=10];

  root [label="根节点\n目标当前位置、线速度\n单位姿态、零角速度", fillcolor="#FFF2CC"];
  pose [label="固定当前候选 Cage 位姿\n整棵树期间不运动"];
  tape [label="生成候选共享扰动带\n3 次独立重复；每棵最多 640 节点"];
  density [label="转换到候选末端坐标系\n按位置、线速度、角速度建立 9D 密度格"];
  select [label="低密度优先选择父节点\n先均匀选已占用格，再从格内选节点"];
  disturb [label="施加随机外力、随机力矩\n持续 15–60 ms"];
  sim [label="MuJoCo 正式动力学积分\n步长 5 ms", fillcolor="#DDEBF7"];
  valid [shape=diamond, label="状态有限、局部范围合法\n且穿透不超过 6 mm？", fillcolor="#FCE4D6"];
  illegal [label="标记 Illegal\n计入分母，不再扩展", fillcolor="#F4CCCC"];
  inside [shape=diamond, label="物体中心位于真实\nU 形抓子内部？", fillcolor="#E2F0D9"];
  status [label="记录 Inside / Outside\n以及开口逃逸状态"];
  stop [shape=diamond, label="达到 640 节点、0.8 s\n或无可选父节点？", fillcolor="#FCE4D6"];
  score [label="单棵树得分\nInside 节点数 / 全部节点数", fillcolor="#D9EAD3"];
  repeat [label="同一候选重复 3 次\n计算均值和标准差"];
  winner [label="所有候选使用相同条件比较\n选择 EST 均值最大者", fillcolor="#CFE2F3"];
  output [label="保存最佳 Cage 位姿、归一化劣弧位置\n半径、弧起止角、EST 审计数据", fillcolor="#FFF2CC"];

  arc_bias [shape=note, label="扰动力方向：\n70% 朝当前运动劣弧扇区\n30% 保留全三维探索", fillcolor="#F3F3F3"];
  real_region [shape=note, label="保持判据：真实抓子内部几何\n不存在旧的 ±30° Cap 扫掠体", fillcolor="#F3F3F3"];

  root -> pose -> tape -> density -> select -> disturb -> sim -> valid;
  valid -> illegal [label="否"];
  valid -> inside [label="是"];
  inside -> status [label="是 / 否"];
  status -> stop;
  illegal -> stop;
  stop -> density [label="继续", constraint=false];
  stop -> score [label="结束"];
  score -> repeat -> winner -> output;
  arc_bias -> tape [style=dashed, arrowhead=none];
  real_region -> inside [style=dashed, arrowhead=none];
}
